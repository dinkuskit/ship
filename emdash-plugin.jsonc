{
  "$schema": "./node_modules/@emdash-cms/plugin-cli/schemas/emdash-plugin.schema.json",
  "slug": "dinkus-ship",
  "publisher": "did:plc:ekk4pjmkh3k3ql2kfoex3qt4",
  "name": "Ship",
  "description": "Buy, print and cancel USPS shipping labels for paid orders in EmDash, through the hosted DinkusKit Ship service.",
  "license": "MIT",
  "author": {
    "name": "DinkusKit",
    "url": "https://github.com/dinkuskit"
  },
  "security": {
    "url": "https://github.com/dinkuskit/ship/security"
  },
  "repo": "https://github.com/dinkuskit/ship",
  "capabilities": [
    "network:request"
  ],
  "allowedHosts": [
    "dinkuskit.com",
    "ship.dinkuskit.com"
  ],
  "storage": {},
  "admin": {
    "settingsSchema": {
      "connection": {
        "type": "secret",
        "label": "DinkusKit connection",
        "description": "Encrypted Store ID and this plugin's own DinkusKit store key. Managed by Connect on the Shipping page; don't change it here."
      }
    },
    "pages": [
      { "path": "/shipping", "label": "Shipping", "icon": "truck" }
    ]
  }
}
