{
  "$schema": "./node_modules/@emdash-cms/plugin-cli/schemas/emdash-plugin.schema.json",
  "slug": "dinkus-ship",
  "publisher": "did:plc:ekk4pjmkh3k3ql2kfoex3qt4",
  "name": "DinkusKit Ship",
  "description": "Compare USPS rates and practise buying, printing and cancelling labels in EmDash. Sandbox labels only; not valid postage.",
  "keywords": ["shipping", "USPS", "shipping labels", "fulfillment", "ecommerce"],
  "sections": {
    "description": { "file": "./docs/registry-listing/description.md" },
    "installation": { "file": "./docs/registry-listing/installation.md" },
    "faq": { "file": "./docs/registry-listing/faq.md" }
  },
  "release": {
    "artifacts": {
      "icon": { "file": "./assets/listing/icon.webp" }
    }
  },
  "license": "MIT",
  "author": {
    "name": "DinkusKit",
    "url": "https://dinkuskit.com"
  },
  "security": {
    "url": "https://github.com/dinkuskit/ship/security"
  },
  "repo": "https://github.com/dinkuskit/ship",
  "capabilities": [
    "network:request"
  ],
  "allowedHosts": [
    "dinkuskit.com",
    "ship.dinkuskit.com"
  ],
  "storage": {},
  "admin": {
    "settingsSchema": {
      "connection": {
        "type": "secret",
        "label": "DinkusKit connection",
        "description": "Encrypted Store ID and this plugin's own DinkusKit store key. Managed by Connect on the Shipping page; don't change it here."
      }
    },
    "pages": [
      { "path": "/shipping", "label": "Shipments", "icon": "truck", "group": "Dinkus Ship" }
    ]
  }
}
