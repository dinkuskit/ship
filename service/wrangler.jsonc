{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Ronald's deploy agents set the name, the ship.dinkuskit.com route and
  // the account values when they deploy; nothing here deploys anything.
  "name": "dinkus-ship-local",
  "main": "src/entry.ts",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "durable_objects": { "bindings": [{ "name": "SHIP_STORES", "class_name": "StoreShipping" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["StoreShipping"] }],
  "vars": {
    "ACCOUNT_ISSUER": "",
    "ACCOUNT_AUDIENCE": "",
    "ACCOUNT_JWKS_URL": "",
    "ACCOUNT_SIGNIN_URL": "",
    "ACCOUNT_TOKEN_URL": "",
    "PB_ENVIRONMENT": "",
    // DinkusKit's Pitney Bowes developer id (Developer Hub, Profile), for owners' own postage accounts.
    "PB_DEVELOPER_ID": "",
    // orders@dinkuskit.com once DinkusKit's Cloudflare Email Service sends for dinkuskit.com.
    "SHIP_EMAIL_FROM": ""
  },
  "send_email": [{ "name": "EMAIL" }]
  // Secrets, set with `wrangler secret put`: SHIP_SESSION_SECRET (32+ random characters);
  // PB_API_KEY, PB_API_SECRET and PB_SHIPPER_ID (Pitney Bowes sandbox, set by Ronald).
}
