#!/usr/bin/env sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(dirname -- "$script_dir")
cd "$repo_root"
mode="${1:-quick}"

case "$mode" in
  quick)
    # The Registry plugin: types, build, the 128 KiB bundle check and its tests.
    npm run typecheck
    npm test
    ;;
  full)
    "$script_dir/verify-ship" quick
    # The hosted service under service/ (install it first: cd service && npm ci --ignore-scripts).
    (cd service && npm run typecheck && npm test && npm run build && npm run build:sandbox && npm run verify:entry)
    # A dry release preparation, as the release workflow runs it.
    node scripts/prepare-emdash-release.mjs "dinkus-ship@$(node -p 'require("./package.json").version')"
    ;;
  *)
    echo "Usage: bin/verify-ship [quick|full]" >&2
    exit 64
    ;;
esac

printf 'verify-ship: %s passed\n' "$mode"
