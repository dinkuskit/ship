{
  "blocks": [
    {
      "type": "header",
      "text": "Shipping settings"
    },
    {
      "type": "header",
      "text": "Ship from"
    },
    {
      "type": "context",
      "text": "The return address printed on every label."
    },
    {
      "type": "form",
      "block_id": "ship-from",
      "fields": [
        {
          "type": "text_input",
          "action_id": "name",
          "label": "Name",
          "initial_value": "Demo Owner"
        },
        {
          "type": "text_input",
          "action_id": "company",
          "label": "Company (optional)",
          "initial_value": "Acme Goods"
        },
        {
          "type": "text_input",
          "action_id": "line1",
          "label": "Address",
          "initial_value": "2 Warehouse Rd"
        },
        {
          "type": "text_input",
          "action_id": "line2",
          "label": "Address line 2 (optional)"
        },
        {
          "type": "text_input",
          "action_id": "city",
          "label": "City",
          "initial_value": "Shiptown"
        },
        {
          "type": "text_input",
          "action_id": "region",
          "label": "State",
          "initial_value": "NY",
          "placeholder": "NY"
        },
        {
          "type": "text_input",
          "action_id": "postalCode",
          "label": "ZIP code",
          "initial_value": "10001"
        }
      ],
      "submit": {
        "label": "Save ship-from address",
        "action_id": "save:ship-from"
      }
    },
    {
      "type": "divider"
    },
    {
      "type": "header",
      "text": "Pitney Bowes postage"
    },
    {
      "type": "section",
      "text": "Connected to Pitney Bowes: Demo Co · postage account ending 4321 · owner@example.test. Connected Nov 22, 2026."
    },
    {
      "type": "context",
      "text": "Labels for real orders are paid from this account. Pitney Bowes charges your card there, not DinkusKit."
    },
    {
      "type": "actions",
      "elements": [
        {
          "type": "button",
          "label": "Disconnect Pitney Bowes",
          "action_id": "disconnect_postage",
          "style": "danger",
          "confirm": {
            "title": "Disconnect Pitney Bowes?",
            "text": "Ship stops buying labels for real orders until you connect a Pitney Bowes account again. Labels already bought stay as they are.",
            "confirm": "Disconnect",
            "deny": "Keep connected",
            "style": "danger"
          }
        }
      ]
    },
    {
      "type": "divider"
    },
    {
      "type": "header",
      "text": "Shipped email"
    },
    {
      "type": "context",
      "text": "Sent from orders@dinkuskit.com under the name Demo Shop (your store's Site title) when a label is bought. When a shopper replies, the reply goes to this address."
    },
    {
      "type": "form",
      "block_id": "reply-to",
      "fields": [
        {
          "type": "text_input",
          "action_id": "replyTo",
          "label": "Reply-to email",
          "initial_value": "help@acme.example",
          "placeholder": "you@example.com"
        }
      ],
      "submit": {
        "label": "Save reply-to email",
        "action_id": "save:reply-to"
      }
    },
    {
      "type": "divider"
    },
    {
      "type": "header",
      "text": "Box sizes"
    },
    {
      "type": "table",
      "page_action_id": "boxes",
      "empty_text": "No box sizes yet. Labels need at least one.",
      "columns": [
        {
          "key": "name",
          "label": "Name"
        },
        {
          "key": "size",
          "label": "Size"
        },
        {
          "key": "empty",
          "label": "Empty weight"
        },
        {
          "key": "remove",
          "label": "",
          "format": "element"
        }
      ],
      "rows": [
        {
          "name": "Small mailer",
          "size": "8 × 6 × 4 in",
          "empty": "3 oz",
          "remove": {
            "type": "button",
            "label": "Remove",
            "action_id": "remove_box",
            "value": "box_1",
            "confirm": {
              "title": "Remove Small mailer?",
              "text": "Labels already bought in this box stay as they are.",
              "confirm": "Remove",
              "deny": "Keep",
              "style": "danger"
            }
          }
        },
        {
          "name": "Medium box",
          "size": "12 × 10 × 6 in",
          "empty": "7.5 oz",
          "remove": {
            "type": "button",
            "label": "Remove",
            "action_id": "remove_box",
            "value": "box_2",
            "confirm": {
              "title": "Remove Medium box?",
              "text": "Labels already bought in this box stay as they are.",
              "confirm": "Remove",
              "deny": "Keep",
              "style": "danger"
            }
          }
        }
      ]
    },
    {
      "type": "form",
      "block_id": "boxes",
      "fields": [
        {
          "type": "text_input",
          "action_id": "name",
          "label": "Box name",
          "placeholder": "Small mailer"
        },
        {
          "type": "text_input",
          "action_id": "lengthIn",
          "label": "Length (in)"
        },
        {
          "type": "text_input",
          "action_id": "widthIn",
          "label": "Width (in)"
        },
        {
          "type": "text_input",
          "action_id": "heightIn",
          "label": "Height (in)"
        },
        {
          "type": "text_input",
          "action_id": "weightOz",
          "label": "Empty weight (oz)",
          "initial_value": "0"
        }
      ],
      "submit": {
        "label": "Add box size",
        "action_id": "save:boxes"
      }
    },
    {
      "type": "actions",
      "elements": [
        {
          "type": "link",
          "label": "Shipments",
          "target": {
            "kind": "plugin-page",
            "path": "/shipping"
          },
          "appearance": "secondary"
        },
        {
          "type": "link",
          "label": "Ship's own Settings",
          "target": {
            "kind": "external",
            "url": "https://ship.dinkuskit.com/stores/site_demo/settings"
          },
          "appearance": "secondary"
        }
      ]
    }
  ],
  "toast": {
    "type": "success",
    "message": "Pitney Bowes connected."
  }
}
