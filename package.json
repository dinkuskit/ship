{
  "name": "@dinkuskit/ship",
  "version": "0.3.0",
  "description": "Buy, print and cancel USPS labels in the EmDash store admin, through the hosted DinkusKit Ship service",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "files": [
    "dist",
    "emdash-plugin.jsonc",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "emdash-plugin validate && emdash-plugin build && node scripts/check-registry-bundle.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "changeset": "changeset",
    "release:version": "changeset version && node scripts/sync-lock-version.mjs",
    "proof:release-authority": "node scripts/release-authority-proof.mjs",
    "verify:quick": "bin/verify-ship quick",
    "verify:full": "bin/verify-ship full"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@emdash-cms/blocks": "1.2.0",
    "@emdash-cms/plugin-cli": "0.13.3",
    "@emdash-cms/plugin-types": "0.6.0",
    "emdash": "1.2.0",
    "jsonc-parser": "3.3.1",
    "typescript": "6.0.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dinkuskit/ship.git"
  },
  "main": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./sandbox": "./dist/plugin.mjs"
  },
  "peerDependencies": {
    "emdash": "1.2.0"
  }
}
