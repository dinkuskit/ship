{
  "name": "@dinkuskit/ship",
  "version": "0.0.0",
  "description": "Optional DinkusKit shipping automation. Merchant-owned Pitney Bowes postage accounts; provider actions remain disabled.",
  "type": "module",
  "private": true,
  "files": [
    "src",
    "emdash-plugin.jsonc",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/plugin.js",
    "./plugin": "./src/plugin.js",
    "./workflow": "./src/shipping-workflow.js",
    "./installed": "./src/installed-workflow.js",
    "./host-label-assets": "./src/host-label-assets.js"
  },
  "scripts": {
    "test": "node --test",
    "build": "emdash-plugin build",
    "verify:registry": "node scripts/verify-registry-artifact.mjs",
    "verify:bundle": "node scripts/verify-registry-artifact.mjs --bundle-only",
    "verify:private-assets": "node scripts/verify-private-assets.mjs",
    "dev": "node src/server.js",
    "fixture:proof": "PORT=4328 node test-support/fixture-server.js",
    "verify:sandbox": "node scripts/verify-sandbox-package.mjs",
    "prepare:sandbox": "node scripts/prepare-sandbox-host.mjs",
    "verify:quick": "bin/verify-ship quick",
    "verify:full": "bin/verify-ship full"
  },
  "devDependencies": {
    "@emdash-cms/plugin-cli": "0.13.3",
    "@emdash-cms/plugin-types": "0.6.0",
    "typescript": "6.0.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dinkuskit/ship.git"
  }
}
